<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>RayBlast</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>RayBlast Release;RayBlast Debug;RayBlast Trace;RayBlast WebGL</Configurations>
        <Platforms>AnyCPU;browser-wasm</Platforms>
        <LangVersion>default</LangVersion>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0</TargetFramework>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.EndsWith('Release')) ">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">OS_LINUX;RELEASE</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">OS_WINDOWS;RELEASE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.EndsWith('Debug')) ">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">OS_LINUX;DEBUG</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">OS_WINDOWS;DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" $(Configuration.EndsWith('Trace')) ">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">OS_LINUX;TRACE;DEBUG</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">OS_WINDOWS;TRACE;DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'RayBlast Release' ">
        <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'RayBlast Debug' ">
        <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
        <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NAudio" Version="3.1.0" />
        <PackageReference Include="NAudio.Alsa" Version="3.1.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <PackageReference Include="NAudio.Lame" Version="2.1.0"/>
        <PackageReference Include="NAudio.Midi" Version="3.1.0" />
        <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
        <PackageReference Include="SDL3-CS" Version="3.4.16" />
        <PackageReference Include="SDL3-CS.Native.Image" Version="3.5.0"/>
        <PackageReference Include="SDL3-CS.Native.TTF" Version="3.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RayBlast Engine Core\RayBlast Engine Core.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="Resources\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>